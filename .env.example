PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/smart_banking
JWT_SECRET=replace_with_a_secure_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Required to register an Admin account. Change this before deploying anywhere real.
ADMIN_REGISTRATION_CODE=replace_with_admin_code

# Optional - Google OAuth (leave blank to disable Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional - AI provider (leave blank to disable AI features)
AI_API_KEY=
AI_MODEL=

# Optional - OCR provider (leave blank to disable OCR on receipts)
OCR_API_KEY=
